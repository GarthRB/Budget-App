# Copy to .env and fill in for production.

# Secret used to sign JWT session tokens. Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the API listens on (default 4000).
PORT=4000

# Optional: absolute path to the SQLite database file (default server/data/padelpath.db).
# DATABASE_PATH=/var/data/padelpath.db
